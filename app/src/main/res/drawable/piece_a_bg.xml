<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外发光光晕（由外向内渐浓） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#3360A5FA"/>
        </shape>
    </item>
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp"/>
            <solid android:color="#5960A5FA"/>
        </shape>
    </item>
    <!-- 立体底座投影 -->
    <item android:top="5.5dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp"/>
            <solid android:color="#172554"/>
        </shape>
    </item>
    <!-- 金属包边（亮→暗斜面） -->
    <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="5.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp"/>
            <gradient android:startColor="#BFDBFE" android:centerColor="#60A5FA" android:endColor="#1D4ED8" android:angle="270"/>
        </shape>
    </item>
    <!-- 珐琅主体（三段渐变） -->
    <item android:top="4.2dp" android:left="4.2dp" android:right="4.2dp" android:bottom="6.7dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <gradient android:startColor="#3B82F6" android:centerColor="#2563EB" android:endColor="#1E3A8A" android:angle="270"/>
        </shape>
    </item>
    <!-- 顶部玻璃高光 -->
    <item android:top="4.2dp" android:left="4.2dp" android:right="4.2dp" android:bottom="6.7dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <gradient android:startColor="#66FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.38" android:angle="270"/>
        </shape>
    </item>
</layer-list>

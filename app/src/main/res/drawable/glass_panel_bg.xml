<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮玻璃卡片：底部柔和投影 + 受光面纵向渐变 + 玻璃白高光描边，营造立体悬浮感 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 卡片下方投影 (向下偏移露出) -->
    <item android:top="4dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#2E55493A" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- 2. 卡片受光面 (顶部亮 → 底部微沉，光从上方来) -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FCFBF8"
                android:endColor="#ECE9E2" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
</layer-list>

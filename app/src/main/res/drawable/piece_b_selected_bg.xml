<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中态：极光绿强光晕（双层扩散） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#5939FF14"/>
        </shape>
    </item>
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp"/>
            <solid android:color="#8C39FF14"/>
        </shape>
    </item>
    <!-- 白色亮边 -->
    <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="7dp"/>
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    <!-- 极光绿发光主体 -->
    <item android:top="4.5dp" android:left="4.5dp" android:right="4.5dp" android:bottom="4.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <gradient android:startColor="#86EFAC" android:centerColor="#39FF14" android:endColor="#15803D" android:angle="270"/>
        </shape>
    </item>
    <!-- 顶部玻璃高光 -->
    <item android:top="4.5dp" android:left="4.5dp" android:right="4.5dp" android:bottom="4.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <gradient android:startColor="#80FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.38" android:angle="270"/>
        </shape>
    </item>
</layer-list>

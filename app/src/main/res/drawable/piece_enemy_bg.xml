<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. 最外层：大范围弥散光晕（朱砂红） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <solid android:color="#1AE11D48"/>
        </shape>
    </item>
    
    <!-- 2. 第二层：渐浓的近身光晕 -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="#33E11D48"/>
        </shape>
    </item>
    
    <!-- 3. 第三层：陶瓷底部深色阴影/底座厚度（深胭脂红） -->
    <item android:top="5dp" android:left="3dp" android:right="3dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <solid android:color="#450A0A"/>
        </shape>
    </item>

    <!-- 4. 第四层：主体瓷质基底（朱砂红瓷） -->
    <item android:top="2.5dp" android:left="2.5dp" android:right="2.5dp" android:bottom="4.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <gradient 
                android:startColor="#991B1B" 
                android:centerColor="#DC2626" 
                android:endColor="#7F1D1D" 
                android:angle="270" />
        </shape>
    </item>
    
    <!-- 5. 第五层：菲涅尔透光边缘（极细浅粉珊瑚描边） -->
    <item android:top="2.5dp" android:left="2.5dp" android:right="2.5dp" android:bottom="4.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp"/>
            <stroke android:width="1dp" android:color="#B3FCA5A5"/>
            <solid android:color="#00000000"/>
        </shape>
    </item>

    <!-- 6. 第六层：陶瓷球面高光（左上角径向聚光，模拟球面反光） -->
    <item android:top="3.5dp" android:left="3.5dp" android:right="3.5dp" android:bottom="5.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp"/>
            <gradient 
                android:type="radial"
                android:gradientRadius="45dp"
                android:centerX="0.25"
                android:centerY="0.25"
                android:startColor="#CCFFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>
    
    <!-- 7. 第七层：镜面偏光（顶部弧形渐变，增强玻璃反光感） -->
    <item android:top="3.5dp" android:left="3.5dp" android:right="3.5dp" android:bottom="5.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="9dp"/>
            <gradient 
                android:startColor="#4DFFFFFF" 
                android:centerColor="#00FFFFFF" 
                android:endColor="#00FFFFFF" 
                android:centerY="0.45" 
                android:angle="270"/>
        </shape>
    </item>
</layer-list>

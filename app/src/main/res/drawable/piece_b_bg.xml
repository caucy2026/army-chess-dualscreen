<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp" android:left="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <solid android:color="#92400E"/>
        </shape>
    </item>
    <item android:bottom="4dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp"/>
            <gradient android:startColor="#FBBF24" android:endColor="#D97706" android:angle="135"/>
            <stroke android:width="1.5dp" android:color="#FDE68A"/>
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_window_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp"
        android:rotation="180">

        <!-- 左侧：控制面板与棋子托盘 (针对玩家 B)。
             注意：根布局 rotation=180° 与 B 背靠背观看双重翻转相互抵消，
             B 感知到的顺序就是此处声明顺序，因此必须与主屏 activity_main.xml 完全同序声明 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/glass_panel_bg"
            android:padding="16dp"
            android:layout_marginEnd="16dp">

            <!-- 顶部游戏状态 -->
            <TextView
                android:id="@+id/tv_role_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_b_title"
                android:textColor="@color/color_b"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="等待主屏开启连接..."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border_color" />

            <!-- 轮次指示器 -->
            <TextView
                android:id="@+id/tv_turn_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="等待双方玩家就绪..."
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:padding="8dp"
                android:background="@drawable/turn_indicator_bg" />

            <!-- 玩家 B 的控制按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btn_auto_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auto_layout_btn_text"
                    android:backgroundTint="@color/cell_railway"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btn_ready"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="@string/ready_btn_text"
                    android:backgroundTint="@color/color_b"
                    android:textColor="@color/black" />

                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_btn_text"
                    android:backgroundTint="@color/cell_hq"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- 玩家 B 的待部署托盘 -->
            <TextView
                android:id="@+id/tv_tray_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待部署棋子 (点击选中，再点棋盘放置)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_piece_tray"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical" />

            <!-- 游戏规则速查 (布阵完成进入对弈后替代托盘显示) -->
            <ScrollView
                android:id="@+id/sv_rules"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rules_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/game_rules_text"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- 右侧：棋盘容器 (针对玩家 B 视角翻转) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:background="@drawable/glass_panel_bg"
            android:padding="8dp">

            <FrameLayout
                android:id="@+id/board_layout_wrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <!-- 棋盘连线背景图层 (自定义绘制，传入玩家 B 视角) -->
                <com.huanglong.pad.game.BoardBackgroundView
                    android:id="@+id/board_background_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 12x5 透明棋格交互网格 (系统原生) -->
                <GridLayout
                    android:id="@+id/board_grid_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:rowCount="12"
                    android:columnCount="5"
                    android:orientation="horizontal" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 副屏全局提示条 (仿主屏 Toast)：自身旋转 180° 校正 B 读屏文字方向；
         物理上贴帧缓冲底部，B 背面观看翻转后感知在顶部，与主屏 Toast 顶部位置一致 -->
    <TextView
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="75dp"
        android:rotation="180"
        android:background="@drawable/tip_toast_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:elevation="10dp"
        android:visibility="gone" />

    <!-- 对决裁决浮层 (覆盖全屏，旋转 180° 匹配 B 读屏方向，默认隐藏) -->
    <FrameLayout
        android:id="@+id/battle_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:rotation="180"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/battle_card"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/glass_panel_bg"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battle_vs_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="1"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/sub_fighter_self"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:elevation="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vs_text"
                    android:textColor="@color/color_vs"
                    android:textSize="24sp"
                    android:textStyle="bold|italic"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" />

                <TextView
                    android:id="@+id/sub_fighter_enemy"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:elevation="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sub_battle_result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="正在进行战斗判定..."
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:minLines="2" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

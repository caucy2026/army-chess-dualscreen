<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/app_window_bg"
    android:padding="16dp">

    <!-- 左侧：控制面板与棋子托盘 -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_panel_bg" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glass_panel_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

        <!-- 顶部游戏状态 -->
        <TextView
            android:id="@+id/tv_role_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_a_title"
            android:textColor="@color/color_a"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="游戏正在初始化..."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/border_color" />

        <!-- 轮次指示器 -->
        <TextView
            android:id="@+id/tv_turn_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待双方玩家就绪..."
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="@drawable/turn_indicator_bg" />

        <!-- 控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_auto_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auto_layout_btn_text"
                android:backgroundTint="@color/cell_railway"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_ready"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="@string/ready_btn_text"
                android:backgroundTint="@color/color_a"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_btn_text"
                android:backgroundTint="@color/cell_hq"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 待部署托盘 -->
        <TextView
            android:id="@+id/tv_tray_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待部署棋子 (点击选中，再点棋盘放置)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_piece_tray"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <!-- 游戏规则速查 (布阵完成进入对弈后替代托盘显示) -->
        <ScrollView
            android:id="@+id/sv_rules"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rules_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="@font/zcool_kuaile"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/game_rules_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:fontFamily="@font/zcool_kuaile"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>
        </ScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. 覆盖在最上方的边框框线，强调“装在框里”的感觉 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_stroke" />

    </FrameLayout>

    <!-- 右侧：棋盘容器 -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:background="@drawable/glass_panel_bg"
        android:padding="8dp">

        <FrameLayout
            android:id="@+id/board_layout_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <!-- 棋盘连线背景图层 (自定义绘制) -->
            <com.huanglong.pad.game.BoardBackgroundView
                android:id="@+id/board_background_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <GridLayout
                android:id="@+id/board_grid_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:rowCount="12"
                android:columnCount="5"
                android:orientation="horizontal" />
        </FrameLayout>

    </FrameLayout>
</LinearLayout>

    <!-- 主屏全局提示条 -->
    <TextView
        android:id="@+id/tv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="75dp"
        android:background="@drawable/tip_toast_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:elevation="10dp"
        android:visibility="gone" />

</FrameLayout>
